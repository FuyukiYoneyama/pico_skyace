{
  "schema": 1,
  "name": "pico-skyace-screenshot-no-sd-product",
  "description": "Verify that F5 reports a missing SD card and returns to the game loop without a card attached.",
  "poll_ms": 10,
  "steps": [
    {
      "op": "wait_until",
      "label": "firmware initialized",
      "condition": {"kind": "uart_contains", "text": "DISPLAY init ok (verified lcd_rgb565_pio driver, blocking mode)"},
      "timeout_ms": 10000
    },
    {
      "op": "key_events",
      "label": "start Play",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 10},
        {"state": "released", "code": 10}
      ]
    },
    {"op": "wait", "ms": 250},
    {
      "op": "key_events",
      "label": "request screenshot without an SD card",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 133},
        {"state": "released", "code": 133}
      ]
    },
    {
      "op": "wait_until",
      "label": "missing card is reported",
      "condition": {"kind": "uart_contains", "text": "SCREENSHOT error stage=mount"},
      "timeout_ms": 10000
    },
    {"op": "wait", "ms": 250}
  ]
}
