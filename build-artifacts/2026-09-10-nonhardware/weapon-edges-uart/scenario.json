{
  "schema": 1,
  "name": "pico-skyace-weapon-target-edges-uart-product",
  "description": "Exercise production weapon input edges without relying on LCD timing: missile launches, four-slot saturation, gun plus throttle/roll input, and continued Play execution.",
  "poll_ms": 10,
  "steps": [
    {
      "op": "wait_until",
      "label": "firmware initialized",
      "condition": {"kind": "uart_contains", "text": "DISPLAY init ok (verified lcd_rgb565_pio driver, blocking mode)"},
      "timeout_ms": 10000
    },
    {
      "op": "key_events",
      "label": "start Play",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 10},
        {"state": "released", "code": 10}
      ]
    },
    {"op": "wait", "ms": 250},
    {
      "op": "key_events",
      "label": "launch one missile",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 77},
        {"state": "released", "code": 77}
      ]
    },
    {
      "op": "key_events",
      "label": "fill missile slots and request one extra",
      "gap_ms": 120,
      "events": [
        {"state": "pressed", "code": 77},
        {"state": "released", "code": 77},
        {"state": "pressed", "code": 77},
        {"state": "released", "code": 77},
        {"state": "pressed", "code": 77},
        {"state": "released", "code": 77},
        {"state": "pressed", "code": 77},
        {"state": "released", "code": 77},
        {"state": "pressed", "code": 77},
        {"state": "released", "code": 77}
      ]
    },
    {
      "op": "key_events",
      "label": "hold gun with throttle and roll",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 32},
        {"state": "pressed", "code": 79},
        {"state": "pressed", "code": 183},
        {"state": "held", "code": 32},
        {"state": "held", "code": 79},
        {"state": "held", "code": 183},
        {"state": "held", "code": 32},
        {"state": "held", "code": 79},
        {"state": "held", "code": 183},
        {"state": "released", "code": 32},
        {"state": "released", "code": 79},
        {"state": "released", "code": 183}
      ]
    },
    {"op": "wait", "ms": 500},
    {
      "op": "wait_until",
      "label": "Play remains active",
      "condition": {"kind": "uart_contains", "text": "MODE Title->Play"},
      "timeout_ms": 1000
    }
  ]
}
