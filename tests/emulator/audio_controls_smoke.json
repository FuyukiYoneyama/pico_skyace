{
  "schema": 1,
  "name": "pico-skyace-audio-controls-smoke",
  "description": "Exercise throttle, roll, and pitch controls while the engine is running.",
  "poll_ms": 5,
  "steps": [
    {
      "op": "wait_until",
      "label": "firmware initialized",
      "condition": {"kind": "uart_contains", "text": "BACKLIGHT set level=220 ok=1"},
      "timeout_ms": 3000
    },
    {
      "op": "key_events",
      "label": "start Play",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 10},
        {"state": "released", "code": 10}
      ]
    },
    {"op": "wait", "ms": 250},
    {
      "op": "key_events",
      "label": "accelerate",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 79},
        {"state": "held", "code": 79},
        {"state": "held", "code": 79},
        {"state": "held", "code": 79},
        {"state": "released", "code": 79}
      ]
    },
    {"op": "wait", "ms": 150},
    {
      "op": "key_events",
      "label": "bank right",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 183},
        {"state": "held", "code": 183},
        {"state": "held", "code": 183},
        {"state": "held", "code": 183},
        {"state": "released", "code": 183}
      ]
    },
    {"op": "wait", "ms": 150},
    {
      "op": "key_events",
      "label": "pitch up",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 181},
        {"state": "held", "code": 181},
        {"state": "held", "code": 181},
        {"state": "released", "code": 181}
      ]
    },
    {"op": "wait", "ms": 250},
    {
      "op": "assert",
      "label": "controlled frame remains rendered",
      "condition": {"kind": "region_non_black", "x": 0, "y": 0, "w": 320, "h": 320, "min": 1}
    }
  ]
}
