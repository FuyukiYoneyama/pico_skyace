{
  "schema": 1,
  "name": "pico-skyace-gameover-timeout-product",
  "description": "Run the unmodified production game-over path. Maximum throttle plus nose-down is used only to reach the real ground collision sooner; generous observation windows cover LCD-transfer cost in the cycle-accurate board model, while the firmware deadline remains 10 s.",
  "poll_ms": 10,
  "steps": [
    {
      "op": "wait_until",
      "label": "firmware initialized",
      "condition": {"kind": "uart_contains", "text": "DISPLAY init ok (verified lcd_rgb565_pio driver, blocking mode)"},
      "timeout_ms": 10000
    },
    {
      "op": "key_events",
      "label": "start Play",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 10},
        {"state": "released", "code": 10}
      ]
    },
    {"op": "wait", "ms": 200},
    {
      "op": "key_events",
      "label": "hold throttle and nose down until crash",
      "events": [
        {"state": "pressed", "code": 182},
        {"state": "pressed", "code": 79}
      ]
    },
    {
      "op": "wait_until",
      "label": "play enters game over",
      "condition": {"kind": "uart_contains", "text": "MODE Play->GameOver"},
      "timeout_ms": 100000
    },
    {"op": "wait", "ms": 100},
    {
      "op": "key_events",
      "label": "release crash inputs",
      "events": [
        {"state": "released", "code": 182},
        {"state": "released", "code": 79}
      ]
    },
    {
      "op": "wait_until",
      "label": "game over returns to title (10 s firmware deadline)",
      "condition": {"kind": "uart_contains", "text": "MODE GameOver->Title(timeout)"},
      "timeout_ms": 100000
    },
    {"op": "wait", "ms": 100}
  ]
}
