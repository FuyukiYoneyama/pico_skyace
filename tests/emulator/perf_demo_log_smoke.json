{
  "schema": 1,
  "name": "pico-skyace-perf-demo-log-smoke",
  "description": "Diagnostic-only smoke check for the machine-readable five-minute demo performance log.",
  "poll_ms": 10,
  "steps": [
    {
      "op": "wait_until",
      "label": "firmware initialized",
      "condition": {"kind": "uart_contains", "text": "DISPLAY init ok (verified lcd_rgb565_pio driver"},
      "timeout_ms": 10000
    },
    {
      "op": "wait_until",
      "label": "diagnostic boot record",
      "condition": {"kind": "uart_contains", "text": "PERF_DEMO event=boot"},
      "timeout_ms": 10000
    },
    {
      "op": "wait_until",
      "label": "demo performance window starts",
      "condition": {"kind": "uart_contains", "text": "PERF_DEMO event=start"},
      "timeout_ms": 10000
    },
    {
      "op": "wait_until",
      "label": "demo performance window completes",
      "condition": {"kind": "uart_contains", "text": "PERF_DEMO event=done"},
      "timeout_ms": 30000
    },
    {"op": "wait", "ms": 100}
  ]
}
