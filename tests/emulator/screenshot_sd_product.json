{
  "schema": 1,
  "name": "pico-skyace-screenshot-sd-product",
  "description": "Verify the product F5 screenshot path against the emulator's FAT32 SD model.",
  "poll_ms": 10,
  "steps": [
    {
      "op": "wait_until",
      "label": "firmware initialized",
      "condition": {"kind": "uart_contains", "text": "DISPLAY init ok (verified lcd_rgb565_pio driver, blocking mode)"},
      "timeout_ms": 10000
    },
    {
      "op": "key_events",
      "label": "start Play",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 10},
        {"state": "released", "code": 10}
      ]
    },
    {"op": "wait", "ms": 250},
    {
      "op": "key_events",
      "label": "capture screenshot with F5",
      "gap_ms": 50,
      "events": [
        {"state": "pressed", "code": 133},
        {"state": "released", "code": 133}
      ]
    },
    {
      "op": "wait_until",
      "label": "screenshot is written",
      "condition": {"kind": "uart_contains", "text": "SCREENSHOT done status=ok"},
      "timeout_ms": 180000
    }
  ]
}
