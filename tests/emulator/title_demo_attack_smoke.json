{
  "schema": 1,
  "name": "pico-skyace-title-demo-attack-smoke",
  "description": "Wait for the 30-second title timeout, confirm the real-play demo starts at Wave 4, and verify its HUD renders.",
  "poll_ms": 10,
  "steps": [
    {
      "op": "wait_until",
      "label": "firmware initialized",
      "condition": {"kind": "uart_contains", "text": "BACKLIGHT set level=220 ok=1"},
      "timeout_ms": 3000
    },
    {
      "op": "wait_until",
      "label": "title enters demo after 30 seconds",
      "condition": {"kind": "uart_contains", "text": "MODE Title->Demo"},
      "timeout_ms": 33000
    },
    {
      "op": "wait_until",
      "label": "demo starts at Wave 4",
      "condition": {"kind": "uart_contains", "text": "WAVE START wave=4 enemies=5"},
      "timeout_ms": 1000
    },
    {"op": "wait", "ms": 500},
    {"op": "snapshot", "png": "demo-attack.png"},
    {
      "op": "assert",
      "label": "demo attack frame is rendered",
      "condition": {"kind": "region_non_black", "x": 0, "y": 0, "w": 320, "h": 320, "min": 1}
    }
  ]
}
